    "sample_period_ms": 250
  },
  "displays": {
    "service_period_ms": 20,
    "oled_refresh_period_ms": 1000
  },
  "scheduler": {
    "heartbeat_period_ms": 100,
    "scheduling_policy": "fixed-rate",
    "missed_release_policy": "skip missed releases; do not execute catch-up bursts"
  },
  "sram_policy": {
    "target_free_bytes": 512,
    "minimum_free_bytes": 400
  }
