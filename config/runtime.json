{
  "schema_version": "1.0",
  "authority": {
    "status": "canonical",
    "domain": "runtime timing, scheduler periods, debounce policy, blink-speed policy, serial rate and operational SRAM margins",
    "baseline_commit": "c77129ee002ab68e510465770d4d8eaa45cd6b19",
